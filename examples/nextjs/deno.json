{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:next dev --port=5555",
    "build": "deno run -A --node-modules-dir npm:next build",
    "start": "deno run -A --node-modules-dir npm:next start --port=5555"
  },
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react"
  },
  "imports": {
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.3.2",
    "@types/node": "npm:@types/node@^20",
    "@types/react": "npm:@types/react@^19.2.14",
    "@types/react-dom": "npm:@types/react-dom@^19.2.3",
    "next": "npm:next@^16",
    "react": "npm:react@^19.2.4",
    "react-dom": "npm:react-dom@^19.2.4",
    "tailwindcss": "npm:tailwindcss@^4.3.2",
    "typescript": "npm:typescript@^5.9.3"
  }
}
